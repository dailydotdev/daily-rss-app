DAILY_CLIENT_ID=
DAILY_CLIENT_SECRET=
DAILY_API_URL=https://api.daily.dev
APP_URL=http://localhost:3006

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# How long a rendered feed is served from cache before daily.dev is asked again.
# 8 hours = 3 API requests a day per feed, which fits the free quota of 200 requests per 30 days.
FEED_CACHE_SECONDS=28800
FEED_ITEMS=30

# Extra hostnames the dev server accepts, comma separated (e.g. a tunnel host).
DEV_ALLOWED_HOSTS=
